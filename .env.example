# Generation Watch — Environment Configuration
# Generation Watch operates without AI inference APIs or paid external credentials.
# External research sources (GDELT DOC 2.0, World Bank Open Data, Harvard Dataverse) use public endpoints.

PORT=3000
APP_URL="http://localhost:3000"
GDELT_CACHE_TTL_MS=900000
WORLDBANK_CACHE_TTL_MS=3600000

# --- Live data sources (optional; the app works without them) ---
# ACLED: free myACLED account at https://acleddata.com . Read ACLED's Terms of Use before showing its data publicly.
ACLED_EMAIL=""
ACLED_PASSWORD=""
# UCDP: request a token by email (see https://ucdp.uu.se/apidocs/). Candidate (monthly) version string can change.
UCDP_ACCESS_TOKEN=""
UCDP_GED_VERSION="26.0.9"
